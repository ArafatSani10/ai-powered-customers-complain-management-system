// PostType Enum
export const PostType = {
    CORE_COURSE: "Core Course",
    ELECTIVE_COURSE: "Elective Course",
    LAB_SESSION: "Lab Session",
    RESEARCH_PROJECT: "Research Project",
    CORPORATE_TRAINING: "Corporate Training",
    COMPLIANCE_MODULE: "Compliance Module",
    ONBOARDING_SESSION: "Onboarding Session",
    SKILL_DEVELOPMENT: "Skill Development",
    WORKSHOP_SEMINAR: "Workshop Seminar",
    CERTIFICATION_PROGRAM: "Certification Program"
};

// Available Keywords/Categories for Suggestions
export const AvailableKeywords = [
    // --- Science & Engineering Subjects ---
    "Physics", "Chemistry", "Mathematics", "Higher Math", "Biology", "Zoology", "Botany",
    "General Science", "Computer Science", "Electrical Engineering", "Civil Engineering",

    // --- Arts & Humanities ---
    "Bangla", "English", "History", "Economics", "Civics", "Geography", "Psychology",
    "Sociology", "Political Science", "Islamic Studies", "Law",

    // --- Business Studies ---
    "Accounting", "Finance", "Marketing", "Management", "Statistics", "Business Math",

    // --- IT & Software Development ---
    "Web Development", "App Development", "Software Engineering", "Game Development",
    "UI UX Design", "DevOps", "Cyber Security", "Cloud Computing", "Blockchain",
    "Data Science", "Machine Learning", "Artificial Intelligence",

    // --- Programming Languages & Tools ---
    "JavaScript", "Python", "Java", "C Programming", "C Plus Plus", "TypeScript",
    "PHP", "Database", "Git GitHub",

    // --- Skill Development & Others ---
    "Freelancing", "Digital Marketing", "Graphics Design", "Video Editing",
    "IELTS Preparation", "Job Preparation", "Research"
];

// Create Post Modal with New Keyword System
const CreatePostModal = ({ onClose, onSubmit, selectedFiles, setSelectedFiles, fileInputRef, handleFileUpload }) => {
    const { register, handleSubmit, formState: { errors, isSubmitting } } = useForm();

    // Keyword state and functions
    const [keywords, setKeywords] = useState([]);
    const [currentKeyword, setCurrentKeyword] = useState('');
    const [showSuggestions, setShowSuggestions] = useState(false);
    const [suggestions, setSuggestions] = useState([]);
    const [keywordError, setKeywordError] = useState('');

    // Handle adding keyword
    const handleAddKeyword = (keyword) => {
        const cleanKeyword = keyword.replace(/^#+/, '').trim();

        if (cleanKeyword && cleanKeyword.length > 0) {
            // Check if keyword already exists
            if (keywords.includes(cleanKeyword)) {
                setKeywordError(`"${cleanKeyword}" already added! Duplicate keywords are not allowed.`);
                setTimeout(() => setKeywordError(''), 3000);
                return;
            }

            if (keywords.length >= 9) {
                setKeywordError("Maximum 9 keywords allowed! Please remove some keywords to add more.");
                setTimeout(() => setKeywordError(''), 3000);
                return;
            }

            setKeywords(prev => [...prev, cleanKeyword]);
            setCurrentKeyword('');
            setKeywordError('');
        }
    };

    // Handle removing keyword
    const handleRemoveKeyword = (index) => {
        setKeywords(prev => prev.filter((_, i) => i !== index));
        setKeywordError('');
    };

    // Handle keyboard events
    const handleKeyDown = (e) => {
        if (e.key === 'Enter' || e.key === ',') {
            e.preventDefault();
            if (currentKeyword.trim()) {
                handleAddKeyword(currentKeyword);
            }
        }

        // Handle backspace when input is empty
        if (e.key === 'Backspace' && !currentKeyword && keywords.length > 0) {
            handleRemoveKeyword(keywords.length - 1);
        }
    };

    // Handle suggestion selection
    const handleSelectSuggestion = (suggestion) => {
        handleAddKeyword(suggestion);
        setShowSuggestions(false);
    };

    // Update suggestions based on input and focus
    useEffect(() => {
        if (currentKeyword.length > 0) {
            const searchTerm = currentKeyword.toLowerCase();
            const filtered = AvailableKeywords.filter(keyword =>
                keyword.toLowerCase().includes(searchTerm)
            ).filter(keyword => !keywords.includes(keyword));
            setSuggestions(filtered.slice(0, 15));
            setShowSuggestions(true);
        } else {
            // When input is focused but empty, show all available keywords
            const filtered = AvailableKeywords.filter(keyword => !keywords.includes(keyword));
            setSuggestions(filtered.slice(0, 15));
        }
    }, [currentKeyword, keywords]);

    // Handle input focus
    const handleInputFocus = () => {
        if (currentKeyword.length === 0) {
            const filtered = AvailableKeywords.filter(keyword => !keywords.includes(keyword));
            setSuggestions(filtered.slice(0, 15));
            setShowSuggestions(true);
        }
    };

    // Close suggestions when clicking outside
    useEffect(() => {
        const handleClickOutside = (event) => {
            if (!event.target.closest('.suggestions-container')) {
                setShowSuggestions(false);
            }
        };

        document.addEventListener('mousedown', handleClickOutside);
        return () => document.removeEventListener('mousedown', handleClickOutside);
    }, []);

    const removeFile = (index) => {
        setSelectedFiles(prev => prev.filter((_, i) => i !== index));
    };

    // Handle form submission
    const onSubmitForm = (data) => {
        if (keywords.length < 4) {
            setKeywordError("Please add at least 4 keywords (minimum 4, maximum 9)");
            return;
        }

        if (keywords.length > 9) {
            setKeywordError("Maximum 9 keywords allowed! Please remove some keywords.");
            return;
        }

        // Add keywords to form data
        const formData = {
            ...data,
            keywords: keywords
        };

        onSubmit(formData);
    };

    // Check if form should be disabled
    const isFormDisabled = keywords.length > 9 || keywords.length < 4 || isSubmitting;

    return (
        <div className="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/90 backdrop-blur-md overflow-hidden">
            <motion.form
                initial={{ y: 50, opacity: 0 }}
                animate={{ y: 0, opacity: 1 }}
                exit={{ y: 50, opacity: 0 }}
                onSubmit={handleSubmit(onSubmitForm)}
                className="bg-gradient-to-br from-[#1a1a2e] to-[#16213e] w-full max-w-2xl rounded-2xl border border-white/10 flex flex-col max-h-[90vh] shadow-2xl relative"
            >
                {/* Close button */}
                <button
                    type="button"
                    onClick={onClose}
                    className="absolute -top-3 -right-3 w-8 h-8 bg-red-500 text-white rounded-full flex items-center justify-center hover:bg-red-600 transition-colors z-[110] shadow-lg"
                >
                    <X size={18} />
                </button>

                {/* Header */}
                <div className="p-8 pb-0">
                    <h2 className="text-2xl font-bold text-white mb-4">Create New Post</h2>
                </div>

                {/* Scrollable Content Body */}
                <div className="p-8 pt-2 overflow-y-auto custom-scrollbar space-y-6">
                    <div>
                        <label className="block text-sm font-bold text-gray-400 mb-2">Title *</label>
                        <input
                            {...register("title", { required: "Title is required" })}
                            className="w-full bg-transparent border border-white/10 rounded-lg p-4 text-white outline-none focus:border-purple-500 transition-all"
                            placeholder="What's the issue?"
                            disabled={keywords.length > 9}
                        />
                        {errors.title && <p className="text-red-400 text-sm mt-2">{errors.title.message}</p>}
                    </div>

                    <div>
                        <label className="block text-sm font-bold text-gray-400 mb-2">Post Type *</label>
                        <select
                            {...register("postType", { required: "Post Type is required" })}
                            className="w-full bg-[#1a1a2e] border border-white/10 rounded-lg p-4 text-white outline-none focus:border-purple-500"
                            disabled={keywords.length > 9}
                        >
                            <option value="" className="bg-[#1a1a2e]">Select Type</option>
                            {Object.entries(PostType).map(([key, value]) => (
                                <option key={key} value={value} className="bg-[#1a1a2e]">
                                    {value}
                                </option>
                            ))}
                        </select>
                    </div>

                    {/* Keywords Section */}
                    <div className="mb-6 suggestions-container">
                        <label className="block text-sm font-bold text-gray-400 mb-3">
                            Keywords (Min 4, Max 9)
                            <span className={`ml-2 font-bold ${keywords.length > 9 ? 'text-red-400' :
                                keywords.length >= 4 ? 'text-green-400' : 'text-yellow-400'}`}>
                                {keywords.length}/9 keywords
                            </span>
                        </label>

                        {/* Keyword Chips Container */}
                        <div
                            className="flex flex-wrap gap-2 mb-3 min-h-[60px] p-3 bg-[#1a1a2e]/50 rounded-lg border border-white/5 cursor-text hover:border-purple-500/30 transition-all"
                            onClick={() => document.getElementById('keyword-input')?.focus()}
                        >
                            {keywords.length === 0 ? (
                                <div className="text-gray-500 text-sm italic">
                                    Click here to add keywords (start typing or click suggestions below)
                                </div>
                            ) : (
                                keywords.map((keyword, index) => (
                                    <motion.div
                                        key={index}
                                        initial={{ scale: 0, opacity: 0 }}
                                        animate={{ scale: 1, opacity: 1 }}
                                        exit={{ scale: 0, opacity: 0 }}
                                        className="flex items-center gap-2 bg-gradient-to-r from-purple-600/20 to-blue-600/20 border border-purple-500/30 px-4 py-2 rounded-full group hover:from-purple-600/30 hover:to-blue-600/30 transition-all duration-300"
                                    >
                                        <Tag size={14} className="text-purple-400" />
                                        <span className="text-white text-sm font-medium">#{keyword}</span>
                                        <button
                                            type="button"
                                            onClick={(e) => {
                                                e.stopPropagation();
                                                handleRemoveKeyword(index);
                                            }}
                                            className="text-gray-400 hover:text-red-400 transition-colors p-1 hover:bg-red-500/10 rounded-full"
                                            disabled={keywords.length > 9}
                                        >
                                            <X size={14} />
                                        </button>
                                    </motion.div>
                                ))
                            )}
                        </div>

                        {/* Error Message */}
                        {keywordError && (
                            <motion.div
                                initial={{ opacity: 0, y: -10 }}
                                animate={{ opacity: 1, y: 0 }}
                                className="mb-3 p-3 bg-red-500/10 border border-red-500/30 rounded-lg"
                            >
                                <div className="flex items-center gap-2 text-red-400 text-sm">
                                    <AlertCircle size={14} />
                                    <span>{keywordError}</span>
                                </div>
                            </motion.div>
                        )}

                        {/* Keyword Input with Suggestions */}
                        <div className="relative">
                            <div className="flex items-center gap-2">
                                <input
                                    id="keyword-input"
                                    type="text"
                                    value={currentKeyword}
                                    onChange={(e) => setCurrentKeyword(e.target.value)}
                                    onKeyDown={handleKeyDown}
                                    onFocus={handleInputFocus}
                                    placeholder="Type keyword or click suggestions below..."
                                    className="flex-1 bg-transparent border border-white/10 rounded-lg p-4 text-white outline-none focus:border-purple-500 transition-all"
                                    maxLength={30}
                                    autoComplete="off"
                                    disabled={keywords.length > 9}
                                />
                                <button
                                    type="button"
                                    onClick={() => {
                                        if (currentKeyword.trim()) {
                                            handleAddKeyword(currentKeyword);
                                        }
                                    }}
                                    className="bg-purple-600 hover:bg-purple-700 text-white px-6 py-4 rounded-lg font-bold transition-colors whitespace-nowrap disabled:opacity-50 disabled:cursor-not-allowed"
                                    disabled={keywords.length > 9}
                                >
                                    Add
                                </button>
                            </div>

                            {/* Suggestions Dropdown - Always show when input has focus */}
                            {showSuggestions && suggestions.length > 0 && (
                                <motion.div
                                    initial={{ opacity: 0, y: -10 }}
                                    animate={{ opacity: 1, y: 0 }}
                                    className="absolute z-50 w-full mt-2 bg-[#252644] border border-white/20 rounded-lg shadow-2xl max-h-60 overflow-y-auto ring-1 ring-purple-500/50"
                                >
                                    <div className="p-3 border-b border-white/10 bg-[#1a1a2e]">
                                        <div className="flex items-center gap-2">
                                            <Tag size={14} className="text-purple-400" />
                                            <span className="text-xs text-gray-400">Available Keywords (Click to add)</span>
                                        </div>
                                    </div>
                                    <div className="max-h-48 overflow-y-auto">
                                        {suggestions.map((suggestion, index) => (
                                            <div
                                                key={index}
                                                onClick={() => handleSelectSuggestion(suggestion)}
                                                className="p-3 hover:bg-purple-600 text-white cursor-pointer transition-colors border-b border-white/5 last:border-0 flex items-center gap-3 group"
                                            >
                                                <div className="w-8 h-8 rounded-full bg-gradient-to-r from-purple-500/20 to-blue-500/20 flex items-center justify-center group-hover:from-purple-600/40 group-hover:to-blue-600/40">
                                                    <Tag size={12} className="text-purple-400" />
                                                </div>
                                                <div className="flex-1">
                                                    <div className="font-medium">#{suggestion}</div>
                                                </div>
                                                <ChevronRight size={14} className="text-gray-500 group-hover:text-white" />
                                            </div>
                                        ))}
                                    </div>
                                </motion.div>
                            )}
                        </div>

                        {/* Instructions */}
                        <div className="mt-4 space-y-2">
                            <div className="flex items-center justify-between text-xs">
                                <div className="text-gray-500 flex items-center gap-2">
                                    <div className="flex items-center gap-1">
                                        <Info size={12} />
                                        <span>Click on any keyword below to add</span>
                                    </div>
                                </div>
                                <div className={`font-bold ${keywords.length < 4 ? 'text-yellow-400' :
                                    keywords.length > 9 ? 'text-red-400' : 'text-green-400'}`}>
                                    {keywords.length < 4 ?
                                        `Need ${4 - keywords.length} more` :
                                        keywords.length > 9 ?
                                            'Too many keywords!' :
                                            `${keywords.length} keywords ✓`
                                    }
                                </div>
                            </div>
                        </div>

                        {/* All Available Keywords Grid */}
                        <div className="mt-4 p-4 bg-[#1a1a2e]/50 rounded-lg border border-white/5">
                            <div className="flex items-center gap-2 mb-3">
                                <Tag size={14} className="text-purple-400" />
                                <span className="text-sm font-bold text-gray-400">All Available Keywords:</span>
                                <span className="text-xs text-gray-500 ml-auto">Click to add</span>
                            </div>
                            <div className="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2 max-h-60 overflow-y-auto p-2">
                                {AvailableKeywords.map((keyword, index) => (
                                    <button
                                        key={index}
                                        type="button"
                                        onClick={() => handleAddKeyword(keyword)}
                                        disabled={keywords.includes(keyword) || keywords.length > 9}
                                        className={`text-xs px-3 py-2 rounded-lg border transition-all duration-300 text-left truncate ${keywords.includes(keyword)
                                            ? 'bg-purple-600/30 border-purple-500/50 text-purple-300 cursor-not-allowed'
                                            : keywords.length > 9
                                                ? 'bg-red-500/10 border-red-500/20 text-gray-500 cursor-not-allowed'
                                                : 'bg-white/5 border-white/10 text-gray-400 hover:bg-purple-500/20 hover:border-purple-500/30 hover:text-white'
                                            }`}
                                        title={keywords.includes(keyword) ? `"${keyword}" already added` : `Click to add "${keyword}"`}
                                    >
                                        #{keyword}
                                    </button>
                                ))}
                            </div>
                        </div>
                    </div>

                    <div>
                        <label className="block text-sm font-bold text-gray-400 mb-2">Description *</label>
                        <textarea
                            {...register("content", {
                                required: "Description is required",
                                minLength: { value: 20, message: "Please provide more details (min 20 characters)" }
                            })}
                            className="w-full bg-transparent border border-white/10 rounded-lg p-4 text-white h-32 outline-none focus:border-purple-500 resize-none disabled:opacity-50 disabled:cursor-not-allowed"
                            placeholder="Describe your issue in detail..."
                            disabled={keywords.length > 9}
                        />
                        {errors.content && <p className="text-red-400 text-sm mt-2">{errors.content.message}</p>}
                    </div>

                    {/* File Upload Section */}
                    <div>
                        <label className="block text-sm font-bold text-gray-400 mb-2">Attach Screenshots/Images</label>
                        <div
                            onClick={() => keywords.length <= 9 && fileInputRef.current.click()}
                            className={`border-2 border-dashed rounded-lg p-6 text-center cursor-pointer transition-all group ${keywords.length > 9
                                ? 'border-white/5 bg-white/5 cursor-not-allowed opacity-50'
                                : 'border-white/10 hover:border-purple-500/50 hover:bg-white/5'
                                }`}
                        >
                            <Upload className={`mx-auto mb-3 ${keywords.length > 9 ? 'text-gray-500' : 'text-gray-500 group-hover:text-purple-500'}`} size={28} />
                            <p className={`${keywords.length > 9 ? 'text-gray-500' : 'text-gray-400'}`}>
                                {keywords.length > 9 ? 'Cannot upload files (maximum keywords reached)' : 'Click to upload screenshots or images'}
                            </p>
                            <input
                                type="file"
                                ref={fileInputRef}
                                className="hidden"
                                multiple
                                accept="image/*,video/*"
                                onChange={handleFileUpload}
                                disabled={keywords.length > 9}
                            />
                        </div>
                        {selectedFiles.length > 0 && (
                            <div className="flex flex-wrap gap-3 mt-4">
                                {selectedFiles.map((file, index) => (
                                    <div key={index} className="flex items-center gap-2 bg-white/5 px-4 py-3 rounded-lg border border-white/5">
                                        {file.type.startsWith('image/') ? <ImageIcon size={16} className="text-purple-500" /> : <Video size={16} className="text-blue-500" />}
                                        <span className="text-xs truncate max-w-[100px]">{file.name}</span>
                                        <X size={14} onClick={() => removeFile(index)} className="cursor-pointer hover:text-red-500" />
                                    </div>
                                ))}
                            </div>
                        )}
                    </div>
                </div>

                {/* Footer Sticky */}
                <div className="p-8 pt-4 border-t border-white/10 bg-[#16213e] rounded-b-2xl flex gap-4">
                    <button
                        type="button"
                        onClick={onClose}
                        className="flex-1 bg-white/5 hover:bg-white/10 border border-white/10 rounded-lg py-4 font-bold text-gray-400 transition-all"
                    >
                        Cancel
                    </button>
                    <button
                        type="submit"
                        disabled={isFormDisabled}
                        className={`flex-1 py-4 rounded-lg font-bold transition-all flex items-center justify-center gap-3 ${isFormDisabled
                            ? 'bg-gray-600 text-gray-400 cursor-not-allowed'
                            : 'bg-gradient-to-r from-purple-600 to-blue-600 hover:from-purple-700 hover:to-blue-700 text-white'
                            }`}
                    >
                        {isSubmitting ? (
                            <>
                                <Loader2 className="animate-spin" size={20} />
                                Posting...
                            </>
                        ) : keywords.length > 9 ? (
                            'Too Many Keywords!'
                        ) : keywords.length < 4 ? (
                            `Need ${4 - keywords.length} More Keywords`
                        ) : (
                            'Submit Post'
                        )}
                    </button>
                </div>
            </motion.form>
        </div>
    );
};